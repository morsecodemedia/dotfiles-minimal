##!/usr/bin/env bash

set -euo pipefail

JSON_OUTPUT=false

if [[ "${1:-}" == "--json" ]]; then
    JSON_OUTPUT=true
fi

if $JSON_OUTPUT; then

    ROOT=""
    BRANCH=""
    DIRTY=false
    CHANGED_FILES=0
    NODE_VERSION=""
    NPM_VERSION=""

    if git rev-parse --show-toplevel >/dev/null 2>&1; then
        ROOT=$(git rev-parse --show-toplevel)
        BRANCH=$(git branch --show-current)

        if ! git diff --quiet || ! git diff --cached --quiet; then
            DIRTY=true
        fi
    fi
    if command -v node >/dev/null 2>&1; then
        NODE_VERSION=$(node -v)
    fi

    if command -v npm >/dev/null 2>&1; then
        NPM_VERSION=$(npm -v)
    fi

    cat <<EOF
{
  "repository": {
    "root": "$ROOT",
    "branch": "$BRANCH",
    "dirty": $DIRTY
  },
  "runtime": {
    "shell": "${SHELL##*/}",
    "node": "$NODE_VERSION",
    "npm": "$NPM_VERSION"
  },
  "workstation": {
    "host": "$(hostname)",
    "tmux": $([ -n "${TMUX:-}" ] && echo true || echo false)
  }
}
EOF

    exit 0
fi


printf "\n"
printf "NextGen Workstation Context\n"
printf "===========================\n\n"

printf "Project\n"

if git rev-parse --show-toplevel >/dev/null 2>&1; then
    ROOT=$(git rev-parse --show-toplevel)
    BRANCH=$(git branch --show-current)
    DIRTY="No"

    if ! git diff --quiet || ! git diff --cached --quiet; then
        DIRTY="Yes"
    fi
    
    CHANGED_FILES=$(
      git status --porcelain 2>/dev/null | wc -l | tr -d ' '
    )

    printf "  Root      %s\n" "$ROOT"
    printf "  Branch    %s\n" "$BRANCH"
    printf "  Dirty     %s\n" "$DIRTY"
    printf "  Changed   %s\n" "$CHANGED_FILES"
else
    printf "  Not a Git repository\n"
fi

if [ -f "${ROOT}/package.json" ]; then
    printf "\nProject\n"

    printf "  Type      Node\n"

    if [ -f "${ROOT}/vite.config.js" ] || \
       [ -f "${ROOT}/vite.config.mjs" ] || \
       [ -f "${ROOT}/vite.config.ts" ]; then
        printf "  Framework Vite\n"
    fi
fi

printf "\nRuntime\n"

printf "  Shell     %s\n" "${SHELL##*/}"

if command -v node >/dev/null 2>&1; then
    printf "  Node      %s\n" "$(node -v)"
fi

if command -v npm >/dev/null 2>&1; then
    printf "  npm       %s\n" "$(npm -v)"
fi

printf "\nProject Files\n"

ROOT="${ROOT:-$(pwd)}"

check_file() {
    local label="$1"
    local file="$2"

    if [ -f "$ROOT/$file" ]; then
        printf "  ✓ %-12s %s\n" "$label" "$file"
    else
        printf "  ✗ %-12s %s\n" "$label" "$file"
    fi
}

check_file "README" "README.md"
check_file "Plan" "PLAN.md"
check_file "Roadmap" "ROADMAP.md"
check_file "Architecture" "ARCHITECTURE.md"
check_file "AI" "AI_SUBSYSTEM.md"
check_file "Git Ignore" ".gitignore"
check_file "EditorConfig" ".editorconfig"
check_file "Package" "package.json"
check_file "NVM" ".nvmrc"

printf "\nEngineering Health\n"

if [ "$DIRTY" = "Yes" ]; then
    printf "  ⚠ Repository has uncommitted changes\n"
fi

if [ ! -f "$ROOT/PLAN.md" ]; then
    printf "  ⚠ PLAN.md is missing\n"
fi

if [ -f "$ROOT/package.json" ]; then
    if [ ! -f "$ROOT/.nvmrc" ]; then
        printf "  ⚠ Node project has no .nvmrc\n"
    fi
fi

printf "\nNext Steps\n"

if [ "$DIRTY" = "Yes" ]; then
    printf "  • Review changes with: git diff\n"
fi

if [ ! -f "$ROOT/PLAN.md" ]; then
    printf "  • Consider creating PLAN.md before major work\n"
fi

printf "\nEnvironment\n"

printf "  Host      %s\n" "$(hostname)"

if [ -n "${TMUX:-}" ]; then
    printf "  tmux      Yes\n"
else
    printf "  tmux      No\n"
fi
