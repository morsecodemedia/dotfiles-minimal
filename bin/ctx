#!/usr/bin/env bash

set -euo pipefail

###############################################################################
# Formatting
###############################################################################

heading() {

    printf "\n%s\n" "$1"

    printf "%*s\n" "${#1}" "" | tr ' ' '='
}

section() {

    printf "\n%s\n" "$1"
    printf "────────────────────────\n"
}

###############################################################################
# Output Mode
###############################################################################

OUTPUT_MODE="human"

case "${1:-}" in
    --json)
        OUTPUT_MODE="json"
        ;;
    --env)
        OUTPUT_MODE="env"
        ;;
esac

###############################################################################
# State
###############################################################################

ROOT=""
PROJECT_NAME=""
PROJECT_TYPE="Unknown"
PROJECT_PROFILE="generic"
PROJECT_FRAMEWORK=""

BRANCH=""
DIRTY=false

WORKTREE_STATUS="Clean"

MODIFIED_COUNT=0
UNTRACKED_COUNT=0
STAGED_COUNT=0

# Aggregate change count retained for API compatibility.
CHANGED_FILES=0

TRACKING_BRANCH="None"

AHEAD=0
BEHIND=0

CURRENT_FOCUS=""

NODE_VERSION=""
NPM_VERSION=""

SHELL_NAME="${SHELL##*/}"
HOST_NAME="$(hostname)"
TMUX_RUNNING=false

[[ -n "${TMUX:-}" ]] && TMUX_RUNNING=true

###############################################################################
# Collection
###############################################################################

collect_repository() {

    if ! git rev-parse --show-toplevel >/dev/null 2>&1; then
        return
    fi

    ROOT="$(git rev-parse --show-toplevel)"
    PROJECT_NAME="$(basename "$ROOT")"

    BRANCH="$(git branch --show-current)"

    WORKTREE_STATUS="Clean"
    DIRTY=false

    MODIFIED_COUNT=0
    UNTRACKED_COUNT=0
    STAGED_COUNT=0

    while IFS= read -r line; do

        [[ -z "$line" ]] && continue

        DIRTY=true
        WORKTREE_STATUS="Modified"

        index="${line:0:1}"
        worktree="${line:1:1}"

        # Staged
        if [[ "$index" != " " && "$index" != "?" ]]; then
            ((STAGED_COUNT++))
        fi

        # Modified
        if [[ "$worktree" == "M" ]]; then
            ((MODIFIED_COUNT++))
        fi

        # Untracked
        if [[ "$index$worktree" == "??" ]]; then
            ((UNTRACKED_COUNT++))
        fi

    done < <(git status --porcelain)

    CHANGED_FILES=$((MODIFIED_COUNT + UNTRACKED_COUNT + STAGED_COUNT))

    detect_project
    collect_repository_sync
}

collect_repository_sync() {

    TRACKING_BRANCH="None"

    AHEAD=0
    BEHIND=0

    if git rev-parse --abbrev-ref "@{upstream}" >/dev/null 2>&1; then

        TRACKING_BRANCH="$(
            git rev-parse --abbrev-ref "@{upstream}"
        )"

        read -r AHEAD BEHIND < <(
            git rev-list \
                --left-right \
                --count \
                "HEAD...@{upstream}"
        )

    fi
}

collect_runtime() {

    if command -v node >/dev/null 2>&1; then
        NODE_VERSION="$(node -v)"
    fi

    if command -v npm >/dev/null 2>&1; then
        NPM_VERSION="$(npm -v)"
    fi
}

collect_current_focus() {

    CURRENT_FOCUS="No active task."

    if ! command -v todo >/dev/null 2>&1; then
        CURRENT_FOCUS="Todo provider unavailable."
        return
    fi

    if focus="$(todo current 2>/dev/null)"; then
        CURRENT_FOCUS="$focus"
    fi
}

detect_project() {

    PROJECT_TYPE="Unknown"
    PROJECT_PROFILE="generic"
    PROJECT_FRAMEWORK=""

    if [[ -f "$ROOT/package.json" ]]; then

        PROJECT_TYPE="Node Application"
        PROJECT_PROFILE="node"

        if [[ -f "$ROOT/vite.config.js" ]] ||
           [[ -f "$ROOT/vite.config.mjs" ]] ||
           [[ -f "$ROOT/vite.config.ts" ]]; then

            PROJECT_TYPE="Vite Application"
            PROJECT_PROFILE="vite"
            PROJECT_FRAMEWORK="Vite"

        fi

        return
    fi

    if [[ -f "$ROOT/.profile" ]] &&
       [[ -d "$ROOT/.profile.d" ]]; then

        PROJECT_TYPE="Shell Configuration"
        PROJECT_PROFILE="shell-configuration"
    fi
}

collect() {

    collect_repository
    collect_runtime
    collect_current_focus
}

###############################################################################
# Evaluation
###############################################################################

has_file() {

    [[ -f "$ROOT/$1" ]]
}

project_file_status() {

    local label="$1"
    local file="$2"

    if has_file "$file"; then
        printf "  ✓ %-14s %s\n" "$label" "$file"
    else
        printf "  ✗ %-14s %s\n" "$label" "$file"
    fi
}

ENGINEERING_WARNINGS=()
ENGINEERING_RECOMMENDATIONS=()

evaluate_health() {

    ENGINEERING_WARNINGS=()
    ENGINEERING_RECOMMENDATIONS=()

if [[ "$WORKTREE_STATUS" == "Modified" ]]; then

        ENGINEERING_WARNINGS+=(
            "Repository has uncommitted changes."
        )

        ENGINEERING_RECOMMENDATIONS+=(
            "Review changes with: git diff."
        )

    fi

    case "$PROJECT_PROFILE" in

        node|vite)

            if ! has_file ".nvmrc"; then

                ENGINEERING_WARNINGS+=(
                    "Node project has no .nvmrc."
                )

            fi
            ;;

    esac

    if ! has_file "PLAN.md"; then

        ENGINEERING_WARNINGS+=(
            "Missing PLAN.md."
        )

        ENGINEERING_RECOMMENDATIONS+=(
            "Capture implementation strategy in PLAN.md."
        )

    fi
}

evaluate() {

    evaluate_health
}

###############################################################################
# Rendering
###############################################################################

render_json() {

cat <<EOF
{
  "repository": {
    "name": "$PROJECT_NAME",
    "type": "$PROJECT_TYPE",
    "profile": "$PROJECT_PROFILE",
    "framework": "$PROJECT_FRAMEWORK",

    "root": "$ROOT",
    "branch": "$BRANCH",

    "working_tree": "$WORKTREE_STATUS",

    "modified": $MODIFIED_COUNT,
    "untracked": $UNTRACKED_COUNT,
    "staged": $STAGED_COUNT,

    "changed": $CHANGED_FILES,

    "tracking": "$TRACKING_BRANCH",

    "ahead": $AHEAD,
    "behind": $BEHIND
  },
  "runtime": {
    "shell": "$SHELL_NAME",
    "node": "$NODE_VERSION",
    "npm": "$NPM_VERSION"
  },
  "engineering": {
    "current_focus": "$CURRENT_FOCUS",
    "health": [],
    "recommendations": []
  },
  "environment": {
    "host": "$HOST_NAME",
    "tmux": $TMUX_RUNNING
  }
}
EOF

}

render_env() {

cat <<EOF
CTX_ROOT='$ROOT'

CTX_PROJECT_NAME='$PROJECT_NAME'
CTX_PROJECT_TYPE='$PROJECT_TYPE'
CTX_PROJECT_PROFILE='$PROJECT_PROFILE'
CTX_PROJECT_FRAMEWORK='$PROJECT_FRAMEWORK'

CTX_BRANCH='$BRANCH'

CTX_WORKING_TREE='$WORKTREE_STATUS'

CTX_MODIFIED='$MODIFIED_COUNT'
CTX_UNTRACKED='$UNTRACKED_COUNT'
CTX_STAGED='$STAGED_COUNT'

# Backwards compatibility.
CTX_CHANGED='$CHANGED_FILES'

CTX_TRACKING_BRANCH='$TRACKING_BRANCH'
CTX_AHEAD='$AHEAD'
CTX_BEHIND='$BEHIND'

CTX_CURRENT_FOCUS='$CURRENT_FOCUS'

CTX_NODE='$NODE_VERSION'
CTX_NPM='$NPM_VERSION'
CTX_SHELL='$SHELL_NAME'

CTX_HOST='$HOST_NAME'
CTX_TMUX='$TMUX_RUNNING'
EOF

}

render_repository() {

    section "Repository"

    printf "  Name          %s\n" "$PROJECT_NAME"
    printf "  Type          %s\n" "$PROJECT_TYPE"
    printf "  Profile       %s\n" "$PROJECT_PROFILE"
    printf "  Root          %s\n" "$ROOT"
    printf "  Branch        %s\n" "$BRANCH"

    if [[ -n "$PROJECT_FRAMEWORK" ]]; then
        printf "  Framework     %s\n" "$PROJECT_FRAMEWORK"
    fi

    printf "  Working Tree  %s\n" "$WORKTREE_STATUS"

    printf "  Modified      %d\n" "$MODIFIED_COUNT"
    printf "  Untracked     %d\n" "$UNTRACKED_COUNT"
    printf "  Staged        %d\n" "$STAGED_COUNT"

    if [[ "$TRACKING_BRANCH" == "None" ]]; then

        printf "  Tracking      None\n"

    else

        printf "  Tracking      %s\n" "$TRACKING_BRANCH"

        if ((AHEAD == 0 && BEHIND == 0)); then
            printf "  Commits       Current\n"
        else
            printf "  Commits       ↑ %d  ↓ %d\n" "$AHEAD" "$BEHIND"
        fi

    fi
}

render_focus() {

    section "Current Focus"

    printf "  %s\n" "$CURRENT_FOCUS"
}

render_runtime() {

    section "Runtime"

    printf "  Shell     %s\n" "$SHELL_NAME"

    [[ -n "$NODE_VERSION" ]] &&
        printf "  Node      %s\n" "$NODE_VERSION"

    [[ -n "$NPM_VERSION" ]] &&
        printf "  npm       %s\n" "$NPM_VERSION"
}

render_project_files() {

    section "Repository Artifacts"

    project_file_status "README" "README.md"
    project_file_status "Plan" "PLAN.md"
    project_file_status "Roadmap" "ROADMAP.md"
    project_file_status "Architecture" "ARCHITECTURE.md"
    project_file_status "AI" "AI_SUBSYSTEM.md"
    project_file_status "Git Ignore" ".gitignore"
    project_file_status "Editor Config" ".editorconfig"

    if [[ "$PROJECT_PROFILE" == "node" ]] ||
       [[ "$PROJECT_PROFILE" == "vite" ]]; then

        project_file_status "Package" "package.json"
        project_file_status "NVM" ".nvmrc"

    fi
}

render_health() {

    section "Engineering Health"

    if ((${#ENGINEERING_WARNINGS[@]} == 0)); then
        printf "  ✓ No issues detected.\n"
        return
    fi

    local warning

    for warning in "${ENGINEERING_WARNINGS[@]}"; do
        printf "  ⚠ %s\n" "$warning"
    done
}

render_recommendations() {

    section "Next Steps"

    if ((${#ENGINEERING_RECOMMENDATIONS[@]} == 0)); then
        printf "  ✓ Continue current work.\n"
        return
    fi

    local recommendation

    for recommendation in "${ENGINEERING_RECOMMENDATIONS[@]}"; do
        printf "  • %s\n" "$recommendation"
    done
}

render_environment() {

    section "Environment"

    printf "  Host      %s\n" "$HOST_NAME"

    if $TMUX_RUNNING; then
        printf "  tmux      Yes\n"
    else
        printf "  tmux      No\n"
    fi
}

render_human() {

    heading "NextGen Workstation Context"

    if [[ -z "$ROOT" ]]; then
        printf "\nNot inside a Git repository.\n\n"
        return
    fi

    render_repository
    render_focus
    render_runtime
    render_project_files
    render_health
    render_recommendations
    render_environment

    printf "\n"
}

###############################################################################
# Main
###############################################################################

main() {

    collect

    evaluate

    case "$OUTPUT_MODE" in

        json)
            render_json
            ;;

        env)
            render_env
            ;;

        *)
            render_human
            ;;

    esac
}

main "$@"


