#!/usr/bin/env bash

set -euo pipefail

JSON_OUTPUT=false

if [[ "${1:-}" == "--json" ]]; then
    JSON_OUTPUT=true
fi

###############################################################################
# State
###############################################################################

ROOT=""
BRANCH=""
DIRTY=false
CHANGED_FILES=0

PROJECT_TYPE="Unknown"
PROJECT_FRAMEWORK=""

NODE_VERSION=""
NPM_VERSION=""
SHELL_NAME="${SHELL##*/}"
HOST_NAME="$(hostname)"
TMUX_RUNNING=false

[[ -n "${TMUX:-}" ]] && TMUX_RUNNING=true

###############################################################################
# Collection
###############################################################################

collect_repository() {

    if ! git rev-parse --show-toplevel >/dev/null 2>&1; then
        return
    fi

    ROOT="$(git rev-parse --show-toplevel)"
    BRANCH="$(git branch --show-current)"

    if ! git diff --quiet || ! git diff --cached --quiet; then
        DIRTY=true
    fi

    CHANGED_FILES=$(
        git status --porcelain 2>/dev/null | wc -l | tr -d ' '
    )

    detect_project_type
}

collect_runtime() {

    if command -v node >/dev/null 2>&1; then
        NODE_VERSION="$(node -v)"
    fi

    if command -v npm >/dev/null 2>&1; then
        NPM_VERSION="$(npm -v)"
    fi
}

detect_project_type() {

    PROJECT_TYPE="Unknown"
    PROJECT_FRAMEWORK=""

    if [[ -f "$ROOT/package.json" ]]; then
        PROJECT_TYPE="Node"

        if [[ -f "$ROOT/vite.config.js" ]] ||
           [[ -f "$ROOT/vite.config.mjs" ]] ||
           [[ -f "$ROOT/vite.config.ts" ]]; then

            PROJECT_TYPE="Vite"
            PROJECT_FRAMEWORK="Vite"
        fi

        return
    fi

    if [[ -f "$ROOT/.profile" ]] &&
       [[ -d "$ROOT/.profile.d" ]]; then

        PROJECT_TYPE="Shell Configuration"
        return
    fi
}

###############################################################################
# Evaluation
###############################################################################

has_file() {
    [[ -f "$ROOT/$1" ]]
}

project_file_status() {

    local label="$1"
    local file="$2"

    if has_file "$file"; then
        printf "  ✓ %-12s %s\n" "$label" "$file"
    else
        printf "  ✗ %-12s %s\n" "$label" "$file"
    fi
}

collect_repository
collect_runtime

###############################################################################
# Rendering
###############################################################################

render_json() {

cat <<EOF
{
  "repository": {
    "root": "$ROOT",
    "branch": "$BRANCH",
    "dirty": $DIRTY,
    "changed": $CHANGED_FILES,
    "type": "$PROJECT_TYPE",
    "framework": "$PROJECT_FRAMEWORK"
  },
  "runtime": {
    "shell": "$SHELL_NAME",
    "node": "$NODE_VERSION",
    "npm": "$NPM_VERSION"
  },
  "environment": {
    "host": "$HOST_NAME",
    "tmux": $TMUX_RUNNING
  }
}
EOF

}

render_human() {

    printf "\n"
    printf "NextGen Workstation Context\n"
    printf "===========================\n"

    printf "\nRepository\n"

    if [[ -n "$ROOT" ]]; then

        printf "  Root      %s\n" "$ROOT"
        printf "  Branch    %s\n" "$BRANCH"
        printf "  Type      %s\n" "$PROJECT_TYPE"

        if [[ -n "$PROJECT_FRAMEWORK" ]]; then
            printf "  Framework %s\n" "$PROJECT_FRAMEWORK"
        fi

        if $DIRTY; then
            printf "  Dirty     Yes\n"
        else
            printf "  Dirty     No\n"
        fi

        printf "  Changed   %s\n" "$CHANGED_FILES"

    else

        printf "  Not a Git repository\n"

    fi

    printf "\nRuntime\n"

    printf "  Shell     %s\n" "$SHELL_NAME"

    [[ -n "$NODE_VERSION" ]] &&
        printf "  Node      %s\n" "$NODE_VERSION"

    [[ -n "$NPM_VERSION" ]] &&
        printf "  npm       %s\n" "$NPM_VERSION"

    if [[ -n "$ROOT" ]]; then

        printf "\nProject Files\n"

        project_file_status "README" "README.md"
        project_file_status "Plan" "PLAN.md"
        project_file_status "Roadmap" "ROADMAP.md"
        project_file_status "Architecture" "ARCHITECTURE.md"
        project_file_status "AI" "AI_SUBSYSTEM.md"
        project_file_status "Git Ignore" ".gitignore"
        project_file_status "EditorConfig" ".editorconfig"

        if [[ "$PROJECT_TYPE" == "Node" || "$PROJECT_TYPE" == "Vite" ]]; then
            project_file_status "Package" "package.json"
            project_file_status "NVM" ".nvmrc"
        fi

        printf "\nEngineering Health\n"

        if $DIRTY; then
            printf "  ⚠ Repository has uncommitted changes\n"
        fi

        if ! has_file "PLAN.md"; then
            printf "  ⚠ PLAN.md is missing\n"
        fi

        if [[ "$PROJECT_TYPE" == "Node" || "$PROJECT_TYPE" == "Vite" ]]; then
            if ! has_file ".nvmrc"; then
                printf "  ⚠ Node project has no .nvmrc\n"
            fi
        fi

        printf "\nNext Steps\n"

        if $DIRTY; then
            printf "  • Review changes with: git diff\n"
        fi

        if ! has_file "PLAN.md"; then
            printf "  • Consider creating PLAN.md before major work\n"
        fi

    fi

    printf "\nEnvironment\n"

    printf "  Host      %s\n" "$HOST_NAME"

    if $TMUX_RUNNING; then
        printf "  tmux      Yes\n"
    else
        printf "  tmux      No\n"
    fi

    printf "\n"

}

###############################################################################
# Main
###############################################################################

if $JSON_OUTPUT; then
    render_json
else
    render_human
fi
