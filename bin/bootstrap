#!/opt/homebrew/bin/bash

set -euo pipefail

###############################################################################
# Bootstrap
###############################################################################

WORKSTATION_ROOT="$(
    cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd
)"

WORKSTATION_CONFIG="$HOME/.config/nextgen-workstation"

RUNTIME_ENV="$WORKSTATION_CONFIG/runtime.env"

###############################################################################
# Output
###############################################################################

heading() {

    printf "\n%s\n" "$1"
    printf "%*s\n" "${#1}" "" | tr ' ' '='
}

section() {

    printf "\n%s\n" "$1"
    printf "────────────────────────\n"
}

###############################################################################
# Verification
###############################################################################

verify_command() {

    local command="$1"

    if command -v "$command" >/dev/null 2>&1; then
        printf "  ✓ %s\n" "$command"
    else
        printf "  ✗ %s\n" "$command"
        exit 1
    fi
}

###############################################################################
# Runtime
###############################################################################

write_runtime() {

    mkdir -p "$WORKSTATION_CONFIG"

    cat >"$RUNTIME_ENV" <<EOF
###############################################################################
# NextGen Workstation Runtime
#
# Generated by bootstrap.
###############################################################################

export WORKSTATION_ROOT="$WORKSTATION_ROOT"

export WORKSTATION_CONFIG="$WORKSTATION_CONFIG"

export WORKSTATION_IDENTITY="morse"

export WORKSTATION_VERSION="0.1.0"
EOF
}

verify_runtime() {

    # shellcheck disable=SC1090
    source "$RUNTIME_ENV"

    printf "  ✓ Runtime generated\n"
    printf "  ✓ Root      %s\n" "$WORKSTATION_ROOT"
    printf "  ✓ Config    %s\n" "$WORKSTATION_CONFIG"
    printf "  ✓ Identity  %s\n" "$WORKSTATION_IDENTITY"
    printf "  ✓ Version   %s\n" "$WORKSTATION_VERSION"
}

###############################################################################
# Main
###############################################################################

main() {

    heading "NextGen Bootstrap"

    section "Prerequisites"

    verify_command git
    verify_command jq
    verify_command bash

    section "Runtime"

    write_runtime

    verify_runtime

    printf "\nBootstrap complete.\n\n"
}

main "$@"
