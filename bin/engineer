#!/opt/homebrew/bin/bash

set -euo pipefail

###############################################################################
# Bootstrap
###############################################################################

SCRIPT_DIR="$(
    cd "$(dirname "${BASH_SOURCE[0]}")" && pwd
)"

WORKSTATION_ROOT="$(
    cd "$SCRIPT_DIR/.." && pwd
)"

# shellcheck source=../lib/workstation.sh
source "$WORKSTATION_ROOT/lib/workstation.sh"

eval "$(ctx --env)"

require_git

###############################################################################
# State
###############################################################################

if [[ $# -gt 0 ]]; then

    OBJECTIVE="$*"

elif command -v todo >/dev/null 2>&1; then

    if CURRENT="$(todo current 2>/dev/null)"; then
        OBJECTIVE="$CURRENT"
    else

        printf "Objective: "

        read -r OBJECTIVE

    fi

else

    printf "Objective: "

    read -r OBJECTIVE

fi
CURRENT_FOCUS="No active task."

###############################################################################
# Collection
###############################################################################

collect_focus() {

    if ! command -v todo >/dev/null 2>&1; then
        CURRENT_FOCUS="Todo provider unavailable."
        return
    fi

    if CURRENT_FOCUS_RAW="$(todo current 2>/dev/null)"; then
        CURRENT_FOCUS="$CURRENT_FOCUS_RAW"
    fi
}

###############################################################################
# Artifacts
###############################################################################

write_brief() {

    mkdir -p "$CTX_ROOT/.nextgen"

    cat > "$CTX_ROOT/.nextgen/brief.md" <<EOF
# Engineering Brief

## Objective

$OBJECTIVE

## Repository

- Project: $CTX_PROJECT_TYPE
- Branch: $CTX_BRANCH
- Status: $( [[ "$CTX_DIRTY" == "true" ]] && echo "Dirty" || echo "Clean" )
- Changed Files: $CTX_CHANGED

## Current Focus

$CURRENT_FOCUS

## Requested Outcome

Develop an implementation plan before writing code.

EOF
}

write_session() {

    cat > "$CTX_ROOT/.nextgen/session.md" <<EOF
# Engineering Session

## Started

$(date +"%Y-%m-%d %H:%M:%S")

## Objective

$OBJECTIVE

## Repository

- Project: $CTX_PROJECT_TYPE
- Branch: $CTX_BRANCH

## Current Focus

$CURRENT_FOCUS

---

# Investigation

## Findings

-

## Questions

-

## Risks

-

---

# Plan

-

---

# Decisions

-

---

# Implementation Notes

-

---

# Follow-up

-

EOF
}

###############################################################################
# Rendering
###############################################################################

render_brief() {

    heading "Engineering Brief"

    section "Objective"
    printf "%s\n" "$OBJECTIVE"

    section "Repository"
    printf "Project     %s\n" "$CTX_PROJECT_TYPE"
    printf "Branch      %s\n" "$CTX_BRANCH"

    if [[ "$CTX_DIRTY" == "true" ]]; then
        printf "Status      Dirty\n"
    else
        printf "Status      Clean\n"
    fi

    printf "Changed     %s\n" "$CTX_CHANGED"

    section "Current Focus"
    printf "%s\n" "$CURRENT_FOCUS"

    section "Artifacts"

    printf "Engineering Brief     .nextgen/brief.md\n"
    printf "Engineering Session   .nextgen/session.md\n"

    section "Next"
    printf "Review repository context.\n"
    printf "Identify implementation risks.\n"
    printf "Develop implementation plan.\n"
}

###############################################################################
# Main
###############################################################################

main() {

    collect_focus

    write_brief
    write_session

    render_brief
}

main "$@"
