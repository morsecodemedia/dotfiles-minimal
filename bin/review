#!/usr/bin/env bash

set -euo pipefail

###############################################################################
# Bootstrap
###############################################################################

SCRIPT_DIR="$(
    cd "$(dirname "${BASH_SOURCE[0]}")" && pwd
)"

WORKSTATION_ROOT="$(
    cd "$SCRIPT_DIR/.." && pwd
)"

# shellcheck source-path=SCRIPTDIR/..
# shellcheck source=lib/workstation.sh
source "$WORKSTATION_ROOT/lib/workstation.sh"

eval "$(ctx --env)"

require_git

###############################################################################
# State
###############################################################################

SUMMARY=()

IMPACTS=()

FILES=()

OBSERVATIONS=()

RECOMMENDATIONS=()

DIFF_STAT=""

###############################################################################
# Collection
###############################################################################

collect_summary() {

    SUMMARY=()

    SUMMARY+=("Working Tree: $CTX_WORKING_TREE")

    SUMMARY+=(
        "Modified: $CTX_MODIFIED"
    )

    SUMMARY+=(
        "Untracked: $CTX_UNTRACKED"
    )

    SUMMARY+=(
        "Staged: $CTX_STAGED"
    )
}

collect_files() {

    FILES=()

    while IFS= read -r line; do

        [[ -z "$line" ]] && continue

        FILES+=("$line")

    done < <(git status --short)
}

collect_diff() {

    DIFF_STAT="$(git diff --stat)"
}

collect() {

    collect_summary

    collect_files

    collect_diff
}


