#!/opt/homebrew/bin/bash

set -euo pipefail

###############################################################################
# Bootstrap
###############################################################################

# shellcheck source=/dev/null
source "$HOME/.config/nextgen-workstation/runtime.env"

# shellcheck source=/dev/null
source "$WORKSTATION_ROOT/lib/workstation.sh"

# shellcheck source=/dev/null
source "$WORKSTATION_ROOT/lib/knowledge.sh"

# shellcheck source=/dev/null
source "$WORKSTATION_ROOT/lib/matcher.sh"

eval "$(ctx --env)"

require_git

###############################################################################
# Review Model
###############################################################################

#
# Review Domains
#
# Record Format
#
#     Domain<TAB>Classification<TAB>Priority
#
# Classification
#
#     Risk
#     Information
#
# Priority
#
#     Primary
#     Additional
#

REVIEW_DOMAINS=()

#
# Engineering Context
#
# Record Format
#
#     Domain<TAB>Context
#

ENGINEERING_CONTEXT=()

#
# Recommendations
#
# Record Format
#
#     Domain<TAB>Recommendation
#

RECOMMENDATIONS=()

###############################################################################
# Collection
###############################################################################

SUMMARY=()

EVIDENCE=()

DIFF_STAT=""

collect_summary() {

    SUMMARY=()

    SUMMARY+=("Working Tree: $CTX_WORKING_TREE")
    SUMMARY+=("Modified: $CTX_MODIFIED")
    SUMMARY+=("Untracked: $CTX_UNTRACKED")
    SUMMARY+=("Staged: $CTX_STAGED")
}

collect_evidence() {

    EVIDENCE=()

    mapfile -t STATUS_LINES < <(
        git status --short
    )

    local line

    for line in "${STATUS_LINES[@]}"; do

        [[ -z "$line" ]] && continue

        #
        # Strip git status prefix.
        #

        EVIDENCE+=("${line:3}")

    done
}

collect_diff() {

    DIFF_STAT="$(
        git diff --stat
    )"
}

collect() {

    collect_summary

    collect_evidence

    collect_diff
}

###############################################################################
# Engineering Domains
###############################################################################

is_risk_domain() {

    case "$1" in

        Framework|Executable|Dependencies|Configuration|Build\ System)

            return 0
            ;;

    esac

    return 1
}

is_information_domain() {

    case "$1" in

        Documentation|Architecture|Roadmap|Assets)

            return 0
            ;;

    esac

    return 1
}

domain_priority() {

    case "$1" in

        Framework)      printf "100\n" ;;
        Dependencies)   printf "90\n" ;;
        Configuration)  printf "80\n" ;;
        Executable)     printf "70\n" ;;
        Build\ System)  printf "60\n" ;;

        Documentation)  printf "10\n" ;;
        Architecture)   printf "9\n" ;;
        Roadmap)         printf "8\n" ;;
        Assets)          printf "7\n" ;;

        *)               printf "0\n" ;;

    esac
}

###############################################################################
# Review Domain Engine
###############################################################################

review_domain_exists() {

    local target="$1"

    shift

    local record

    for record in "$@"; do

        [[ "$record" == "$target" ]] && return 0

    done

    return 1
}

review_domain_record() {

    local domain="$1"
    local classification="$2"
    local priority="$3"

    printf "%s\t%s\t%s\n" \
        "$domain" \
        "$classification" \
        "$priority"
}

review_domain_add() {

    local domain="$1"
    local classification="$2"
    local priority="$3"

    local record

    record="$(
        review_domain_record \
            "$domain" \
            "$classification" \
            "$priority"
    )"

    if review_domain_exists \
        "$record" \
        "${REVIEW_DOMAINS[@]}"; then

        return

    fi

    REVIEW_DOMAINS+=("$record")
}

review_domain_remove() {

    local target="$1"

    local remaining=()

    local record

    for record in "${REVIEW_DOMAINS[@]}"; do

        [[ "$record" == "$target" ]] && continue

        remaining+=("$record")

    done

    REVIEW_DOMAINS=("${remaining[@]}")
}

review_domain_promote() {

    local domain="$1"

    local classification

    if is_risk_domain "$domain"; then

        classification="Risk"

    else

        classification="Information"

    fi

    local current=""
    local record
    local name
    local type
    local priority

    for record in "${REVIEW_DOMAINS[@]}"; do

        IFS=$'\t' read -r name type priority <<<"$record"

        [[ "$type" != "$classification" ]] && continue
        [[ "$priority" != "Primary" ]] && continue

        current="$record"

        break

    done

    if [[ -z "$current" ]]; then

        review_domain_add \
            "$domain" \
            "$classification" \
            "Primary"

        return

    fi

    IFS=$'\t' read -r name type priority <<<"$current"

    if (( $(domain_priority "$domain") > $(domain_priority "$name") )); then

        review_domain_remove "$current"

        review_domain_add \
            "$name" \
            "$classification" \
            "Additional"

        review_domain_add \
            "$domain" \
            "$classification" \
            "Primary"

        return

    fi

    review_domain_add \
        "$domain" \
        "$classification" \
        "Additional"
}

###############################################################################
# Evaluation
###############################################################################

record_engineering_context() {

    local knowledge="$1"

    local domain

    domain="$(
        knowledge_category "$knowledge"
    )"

    review_domain_promote "$domain"

    mapfile -t CONTEXT < <(
        knowledge_findings "$knowledge"
    )

    local item
    local record

    for item in "${CONTEXT[@]}"; do

        record="${domain}"$'\t'"${item}"

        review_domain_exists \
            "$record" \
            "${ENGINEERING_CONTEXT[@]}" &&
            continue

        ENGINEERING_CONTEXT+=("$record")

    done

    mapfile -t RECOMMENDATION_ITEMS < <(
        knowledge_recommendations "$knowledge"
    )

    for item in "${RECOMMENDATION_ITEMS[@]}"; do

        record="${domain}"$'\t'"${item}"

        review_domain_exists \
            "$record" \
            "${RECOMMENDATIONS[@]}" &&
            continue

        RECOMMENDATIONS+=("$record")

    done
}

evaluate_knowledge() {

    local evidence="$1"
    local knowledge="$2"

    mapfile -t MATCHES < <(
        knowledge_matches "$knowledge"
    )

    local match
    local type
    local value

    for match in "${MATCHES[@]}"; do

        IFS=$'\t' read -r type value <<<"$match"

        if ! matches \
            "$evidence" \
            "$type" \
            "$value"; then

            continue

        fi

        record_engineering_context "$knowledge"

        return

    done
}

evaluate_evidence() {

    local evidence="$1"

    mapfile -t KNOWLEDGE_ITEMS < <(
        knowledge_items
    )

    local knowledge

    for knowledge in "${KNOWLEDGE_ITEMS[@]}"; do

        evaluate_knowledge \
            "$evidence" \
            "$knowledge"

    done
}

evaluate() {

    REVIEW_DOMAINS=()

    ENGINEERING_CONTEXT=()

    RECOMMENDATIONS=()

    load_knowledge \
        "$WORKSTATION_ROOT/heuristics/review"

    local evidence

    for evidence in "${EVIDENCE[@]}"; do

        evaluate_evidence "$evidence"

    done
}

###############################################################################
# Rendering Helpers
###############################################################################

ordered_review_domains() {

    local primary_risk=()
    local additional_risk=()

    local primary_information=()
    local additional_information=()

    local record
    local domain
    local classification
    local priority

    for record in "${REVIEW_DOMAINS[@]}"; do

        IFS=$'\t' read -r domain classification priority <<<"$record"

        case "${classification}:${priority}" in

            Risk:Primary)

                primary_risk+=("$domain")
                ;;

            Risk:Additional)

                additional_risk+=("$domain")
                ;;

            Information:Primary)

                primary_information+=("$domain")
                ;;

            Information:Additional)

                additional_information+=("$domain")
                ;;

        esac

    done

    printf "%s\n" "${primary_risk[@]}"
    printf "%s\n" "${additional_risk[@]}"
    printf "%s\n" "${primary_information[@]}"
    printf "%s\n" "${additional_information[@]}"
}

engineering_context_for_domain() {

    local target="$1"

    local record
    local domain
    local context

    for record in "${ENGINEERING_CONTEXT[@]}"; do

        IFS=$'\t' read -r domain context <<<"$record"

        [[ "$domain" != "$target" ]] && continue

        printf "%s\n" "$context"

    done
}

recommendations_for_domain() {

    local target="$1"

    local record
    local domain
    local recommendation

    for record in "${RECOMMENDATIONS[@]}"; do

        IFS=$'\t' read -r domain recommendation <<<"$record"

        [[ "$domain" != "$target" ]] && continue

        printf "%s\n" "$recommendation"

    done
}

###############################################################################
# Rendering
###############################################################################

render_summary() {

    section "Summary"

    local line

    for line in "${SUMMARY[@]}"; do
        printf "  • %s\n" "$line"
    done
}

render_evidence() {

    section "Evidence"

    if ((${#EVIDENCE[@]} == 0)); then

        printf "  Working tree is clean.\n"

        return

    fi

    local evidence

    for evidence in "${EVIDENCE[@]}"; do
        printf "  %s\n" "$evidence"
    done
}

render_diff() {

    [[ -z "$DIFF_STAT" ]] && return

    section "Diff Summary"

    printf "%s\n" "$DIFF_STAT"
}

render_focus() {

    section "Engineering Focus"

    local risk_primary=()
    local risk_additional=()
    local info_primary=()
    local info_additional=()

    local record
    local domain
    local classification
    local priority

    for record in "${REVIEW_DOMAINS[@]}"; do

        IFS=$'\t' read -r domain classification priority <<<"$record"

        case "${classification}:${priority}" in

            Risk:Primary)

                risk_primary+=("$domain")
                ;;

            Risk:Additional)

                risk_additional+=("$domain")
                ;;

            Information:Primary)

                info_primary+=("$domain")
                ;;

            Information:Additional)

                info_additional+=("$domain")
                ;;

        esac

    done

    if ((${#risk_primary[@]})); then

        printf "\nRisk-bearing\n\n"

        printf "Primary\n"

        for domain in "${risk_primary[@]}"; do
            printf "  • %s\n" "$domain"
        done

    fi

    if ((${#risk_additional[@]})); then

        printf "\nAdditional\n"

        for domain in "${risk_additional[@]}"; do
            printf "  • %s\n" "$domain"
        done

    fi

    if ((${#info_primary[@]})); then

        printf "\nInformational\n\n"

        printf "Primary\n"

        for domain in "${info_primary[@]}"; do
            printf "  • %s\n" "$domain"
        done

    fi

    if ((${#info_additional[@]})); then

        printf "\nAdditional\n"

        for domain in "${info_additional[@]}"; do
            printf "  • %s\n" "$domain"
        done

    fi
}

render_engineering_context() {

    section "Engineering Context"

    if ((${#ENGINEERING_CONTEXT[@]} == 0)); then

        printf "  • No engineering context.\n"

        return

    fi

    local domain

    while IFS= read -r domain; do

        [[ -z "$domain" ]] && continue

        printf "%s\n\n" "$domain"

        local context

        while IFS= read -r context; do
            printf "  • %s\n" "$context"
        done < <(
            engineering_context_for_domain "$domain"
        )

        printf "\n"

    done < <(
        ordered_review_domains
    )
}

render_recommendations() {

    section "Recommendations"

    local domain

    while IFS= read -r domain; do

        [[ -z "$domain" ]] && continue

        while IFS= read -r recommendation; do
            printf "  • %s\n" "$recommendation"
        done < <(
            recommendations_for_domain "$domain"
        )

    done < <(
        ordered_review_domains
    )
}

###############################################################################
# Human Output
###############################################################################

render_human() {

    heading "Engineering Review"

    render_summary

    render_evidence

    render_diff

    render_focus

    render_engineering_context

    render_recommendations

    printf "\n"
}

###############################################################################
# Main
###############################################################################

main() {

    collect

    evaluate

    render_human
}

main "$@"
