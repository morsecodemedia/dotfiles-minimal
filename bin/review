#!/usr/bin/env bash

set -euo pipefail

###############################################################################
# Bootstrap
###############################################################################

# shellcheck source=/dev/null
source "$HOME/.config/nextgen-workstation/runtime.env"

# shellcheck source=/dev/null
source "$WORKSTATION_ROOT/lib/workstation.sh"

# shellcheck source=/dev/null
source "$WORKSTATION_ROOT/lib/knowledge.sh"

# shellcheck source=/dev/null
source "$WORKSTATION_ROOT/lib/matcher.sh"

eval "$(ctx --env)"

require_git

###############################################################################
# State
###############################################################################

SUMMARY=()

EVIDENCE=()

FINDINGS=()

RECOMMENDATIONS=()

CONFIDENCE_SCORE=0
CONFIDENCE_LEVEL="Unknown"

DIFF_STAT=""

###############################################################################
# Collection
###############################################################################

collect_summary() {

    SUMMARY=()

    SUMMARY+=("Working Tree: $CTX_WORKING_TREE")
    SUMMARY+=("Modified: $CTX_MODIFIED")
    SUMMARY+=("Untracked: $CTX_UNTRACKED")
    SUMMARY+=("Staged: $CTX_STAGED")
}

collect_evidence() {

    EVIDENCE=()

    while IFS= read -r line; do

        [[ -z "$line" ]] && continue

        #
        # Strip git status prefix.
        #
        EVIDENCE+=("${line:3}")

    done < <(
        git status --short
    )
}

collect_diff() {

    DIFF_STAT="$(
        git diff --stat
    )"
}

collect() {

    collect_summary

    collect_evidence

    collect_diff
}

###############################################################################
# Evaluation
###############################################################################

record_finding() {

    local knowledge="$1"

    local finding

    while IFS= read -r finding; do
        FINDINGS+=("$finding")
    done < <(
        knowledge_findings "$knowledge"
    )

    local recommendation

    while IFS= read -r recommendation; do
        RECOMMENDATIONS+=("$recommendation")
    done < <(
        knowledge_recommendations "$knowledge"
    )

    ((CONFIDENCE_SCORE += $(knowledge_weight "$knowledge")))
}

evaluate_knowledge() {

    local evidence="$1"
    local knowledge="$2"

    local type
    local value

printf 'knowledge=[%s]\n' "$knowledge" >&2

knowledge_matches "$knowledge" | while IFS=$'\t' read -r type value; do

        if matches \
            "$evidence" \
            "$type" \
            "$value"; then

            record_finding "$knowledge"

            return

        fi
      done
}

evaluate_evidence() {

    local evidence="$1"

    local knowledge

    while IFS= read -r knowledge; do

        evaluate_knowledge \
            "$evidence" \
            "$knowledge"

    done < <(
        knowledge_items
    )
}

evaluate_confidence() {

    if (( CONFIDENCE_SCORE <= 2 )); then

        CONFIDENCE_LEVEL="Very High"

    elif (( CONFIDENCE_SCORE <= 5 )); then

        CONFIDENCE_LEVEL="High"

    elif (( CONFIDENCE_SCORE <= 8 )); then

        CONFIDENCE_LEVEL="Medium"

    elif (( CONFIDENCE_SCORE <= 12 )); then

        CONFIDENCE_LEVEL="Low"

    else

        CONFIDENCE_LEVEL="Very Low"

    fi
}

evaluate() {

    FINDINGS=()
    RECOMMENDATIONS=()

    CONFIDENCE_SCORE=0

    load_knowledge \
        "$WORKSTATION_ROOT/heuristics/review"

    local evidence

    for evidence in "${EVIDENCE[@]}"; do

        evaluate_evidence "$evidence"

    done

    evaluate_confidence
}

###############################################################################
# Rendering
###############################################################################

render_summary() {

    section "Summary"

    local line

    for line in "${SUMMARY[@]}"; do
        printf "  • %s\n" "$line"
    done
}

render_evidence() {

    section "Evidence"

    if ((${#EVIDENCE[@]} == 0)); then
        printf "  Working tree is clean.\n"
        return
    fi

    local item

    for item in "${EVIDENCE[@]}"; do
        printf "  %s\n" "$item"
    done
}

render_diff() {

    [[ -z "$DIFF_STAT" ]] && return

    section "Diff Summary"

    printf "%s\n" "$DIFF_STAT"
}

render_findings() {

    section "Findings"

    if ((${#FINDINGS[@]} == 0)); then
        printf "  • No findings.\n"
        return
    fi

    local finding

    for finding in "${FINDINGS[@]}"; do
        printf "  • %s\n" "$finding"
    done
}

render_confidence() {

    section "Engineering Confidence"

    printf "  Level      %s\n" "$CONFIDENCE_LEVEL"
    printf "  Score      %d\n" "$CONFIDENCE_SCORE"
}

render_recommendations() {

    section "Recommendations"

    if ((${#RECOMMENDATIONS[@]} == 0)); then
        printf "  • Continue current work.\n"
        return
    fi

    local recommendation

    for recommendation in "${RECOMMENDATIONS[@]}"; do
        printf "  • %s\n" "$recommendation"
    done
}

render_human() {

    heading "Engineering Confidence Review"

    render_summary

    render_evidence

    render_diff

    render_findings

    render_confidence

    render_recommendations

    printf "\n"
}

###############################################################################
# Main
###############################################################################

main() {

    collect

    evaluate

    render_human
}

main "$@"
