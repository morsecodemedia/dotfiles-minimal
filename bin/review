#!/opt/homebrew/bin/bash

set -euo pipefail

###############################################################################
# Bootstrap
###############################################################################

# shellcheck source=/dev/null
source "$HOME/.config/nextgen-workstation/runtime.env"

# shellcheck source=/dev/null
source "$WORKSTATION_ROOT/lib/workstation.sh"

# shellcheck source=/dev/null
source "$WORKSTATION_ROOT/lib/knowledge.sh"

# shellcheck source=/dev/null
source "$WORKSTATION_ROOT/lib/matcher.sh"

eval "$(ctx --env)"

require_git

###############################################################################
# Review Model
###############################################################################

#
# Engineering Domains
#

RISK_PRIMARY=()

RISK_PRESENT=()

INFO_PRIMARY=()

INFO_PRESENT=()

#
# Findings
#

FINDINGS=()

RECOMMENDATIONS=()

#
# Legacy Confidence Model
#
# Temporary until Engineering Focus replaces Engineering Confidence.
#

CONFIDENCE_SCORE=0
CONFIDENCE_LEVEL="Unknown"

###############################################################################
# Collection
###############################################################################

SUMMARY=()

EVIDENCE=()

DIFF_STAT=""

###############################################################################
# Collection
###############################################################################

collect_summary() {

    SUMMARY=()

    SUMMARY+=("Working Tree: $CTX_WORKING_TREE")
    SUMMARY+=("Modified: $CTX_MODIFIED")
    SUMMARY+=("Untracked: $CTX_UNTRACKED")
    SUMMARY+=("Staged: $CTX_STAGED")
}

collect_evidence() {

    EVIDENCE=()

    mapfile -t STATUS_LINES < <(
        git status --short
    )

    local line

    for line in "${STATUS_LINES[@]}"; do

        [[ -z "$line" ]] && continue

        #
        # Strip git status prefix.
        #
        EVIDENCE+=("${line:3}")

    done
}

collect_diff() {

    DIFF_STAT="$(
        git diff --stat
    )"
}

collect() {

    collect_summary

    collect_evidence

    collect_diff
}

###############################################################################
# Engineering Domains
###############################################################################

is_risk_domain() {

    case "$1" in

        Framework|Executable|Dependencies|Configuration|Build\ System)

            return 0
            ;;

    esac

    return 1
}

is_information_domain() {

    case "$1" in

        Documentation|Architecture|Roadmap|Assets)

            return 0
            ;;

    esac

    return 1
}

###############################################################################
# Evaluation
###############################################################################

record_knowledge() {

    local knowledge="$1"

    mapfile -t NEW_FINDINGS < <(
        knowledge_findings "$knowledge"
    )

    local finding

    for finding in "${NEW_FINDINGS[@]}"; do
        FINDINGS+=("$finding")
    done

    mapfile -t NEW_RECOMMENDATIONS < <(
        knowledge_recommendations "$knowledge"
    )

    local recommendation

    for recommendation in "${NEW_RECOMMENDATIONS[@]}"; do
        RECOMMENDATIONS+=("$recommendation")
    done

    ((CONFIDENCE_SCORE += $(knowledge_weight "$knowledge")))
}

evaluate_evidence() {

    local evidence="$1"

    mapfile -t KNOWLEDGE_ITEMS < <(
        knowledge_items
    )

    local knowledge

    for knowledge in "${KNOWLEDGE_ITEMS[@]}"; do

        mapfile -t MATCHES < <(
            knowledge_matches "$knowledge"
        )

        local match

        for match in "${MATCHES[@]}"; do

            local type
            local value

            IFS=$'\t' read -r type value <<<"$match"

            if matches \
                "$evidence" \
                "$type" \
                "$value"; then

                record_knowledge "$knowledge"

                break

            fi

        done

    done
}

evaluate_confidence() {

    case "$CONFIDENCE_SCORE" in

        0|1|2)

            CONFIDENCE_LEVEL="Very High"
            ;;

        3|4|5)

            CONFIDENCE_LEVEL="High"
            ;;

        6|7|8)

            CONFIDENCE_LEVEL="Medium"
            ;;

        9|10|11|12)

            CONFIDENCE_LEVEL="Low"
            ;;

        *)

            CONFIDENCE_LEVEL="Very Low"
            ;;

    esac
}

evaluate() {

    FINDINGS=()
    RECOMMENDATIONS=()

    CONFIDENCE_SCORE=0

    load_knowledge \
        "$WORKSTATION_ROOT/heuristics/review"

    local evidence

    for evidence in "${EVIDENCE[@]}"; do

        evaluate_evidence "$evidence"

    done

    evaluate_confidence
}

###############################################################################
# Rendering
###############################################################################

render_summary() {

    section "Summary"

    local line

    for line in "${SUMMARY[@]}"; do
        printf "  • %s\n" "$line"
    done
}

render_evidence() {

    section "Evidence"

    if ((${#EVIDENCE[@]} == 0)); then
        printf "  Working tree is clean.\n"
        return
    fi

    local evidence

    for evidence in "${EVIDENCE[@]}"; do
        printf "  %s\n" "$evidence"
    done
}

render_diff() {

    [[ -z "$DIFF_STAT" ]] && return

    section "Diff Summary"

    printf "%s\n" "$DIFF_STAT"
}

render_findings() {

    section "Findings"

    if ((${#FINDINGS[@]} == 0)); then
        printf "  • No findings.\n"
        return
    fi

    #
    # Deduplicate findings while preserving order.
    #

    local UNIQUE=()

    local finding

    for finding in "${FINDINGS[@]}"; do

        local seen=false
        local existing

        for existing in "${UNIQUE[@]}"; do

            if [[ "$existing" == "$finding" ]]; then
                seen=true
                break
            fi

        done

        if ! $seen; then
            UNIQUE+=("$finding")
        fi

    done

    for finding in "${UNIQUE[@]}"; do
        printf "  • %s\n" "$finding"
    done
}

render_confidence() {

    section "Engineering Confidence"

    printf "  Level      %s\n" "$CONFIDENCE_LEVEL"
    printf "  Score      %d\n" "$CONFIDENCE_SCORE"
}

render_recommendations() {

    section "Recommendations"

    if ((${#RECOMMENDATIONS[@]} == 0)); then
        printf "  • Continue current work.\n"
        return
    fi

    #
    # Deduplicate recommendations while preserving order.
    #

    local UNIQUE=()

    local recommendation

    for recommendation in "${RECOMMENDATIONS[@]}"; do

        local seen=false
        local existing

        for existing in "${UNIQUE[@]}"; do

            if [[ "$existing" == "$recommendation" ]]; then
                seen=true
                break
            fi

        done

        if ! $seen; then
            UNIQUE+=("$recommendation")
        fi

    done

    for recommendation in "${UNIQUE[@]}"; do
        printf "  • %s\n" "$recommendation"
    done
}

render_human() {

    heading "Engineering Confidence Review"

    render_summary

    render_evidence

    render_diff

    render_findings

    render_confidence

    render_recommendations

    printf "\n"
}

###############################################################################
# Main
###############################################################################

main() {

    collect

    evaluate

    render_human
}

main "$@"
