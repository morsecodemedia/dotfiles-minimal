#!/opt/homebrew/bin/bash

set -euo pipefail

###############################################################################
# Bootstrap
###############################################################################

# shellcheck source=/dev/null
source "$HOME/.config/nextgen-workstation/runtime.env"

# shellcheck source=/dev/null
source "$WORKSTATION_ROOT/lib/workstation.sh"

# shellcheck source=/dev/null
source "$WORKSTATION_ROOT/lib/knowledge.sh"

# shellcheck source=/dev/null
source "$WORKSTATION_ROOT/lib/matcher.sh"

eval "$(ctx --env)"

require_git

###############################################################################
# Review Model
###############################################################################

#
# Engineering Domains
#

RISK_PRIMARY=()

RISK_ADDITIONAL=()

INFO_PRIMARY=()

INFO_ADDITIONAL=()

#
# Findings
#

ENGINEERING_CONTEXT=()

RECOMMENDATIONS=()

#
# Collection
#

SUMMARY=()

EVIDENCE=()

DIFF_STAT=""

###############################################################################
# Collection
###############################################################################

collect_summary() {

    SUMMARY=()

    SUMMARY+=("Working Tree: $CTX_WORKING_TREE")
    SUMMARY+=("Modified: $CTX_MODIFIED")
    SUMMARY+=("Untracked: $CTX_UNTRACKED")
    SUMMARY+=("Staged: $CTX_STAGED")
}

collect_evidence() {

    EVIDENCE=()

    mapfile -t STATUS_LINES < <(
        git status --short
    )

    local line

    for line in "${STATUS_LINES[@]}"; do

        [[ -z "$line" ]] && continue

        #
        # Strip git status prefix.
        #
        EVIDENCE+=("${line:3}")

    done
}

collect_diff() {

    DIFF_STAT="$(
        git diff --stat
    )"
}

collect() {

    collect_summary

    collect_evidence

    collect_diff
}

###############################################################################
# Engineering Domains
###############################################################################

is_risk_domain() {

    case "$1" in

        Framework|Executable|Dependencies|Configuration|Build\ System)

            return 0
            ;;

    esac

    return 1
}

is_information_domain() {

    case "$1" in

        Documentation|Architecture|Roadmap|Assets)

            return 0
            ;;

    esac

    return 1
}

###############################################################################
# Engineering Focus
###############################################################################

domain_priority() {

    case "$1" in

        Framework)      printf "100\n" ;;
        Dependencies)   printf "90\n" ;;
        Configuration)  printf "80\n" ;;
        Executable)     printf "70\n" ;;
        Build\ System)  printf "60\n" ;;

        Documentation)  printf "10\n" ;;
        Architecture)   printf "9\n" ;;
        Roadmap)         printf "8\n" ;;
        Assets)          printf "7\n" ;;

        *)               printf "0\n" ;;

    esac
}

domain_exists() {

    local target="$1"

    shift

    local item

    for item in "$@"; do

        [[ "$item" == "$target" ]] && return 0

    done

    return 1
}

promote_risk_domain() {

    local domain="$1"

    if ((${#RISK_PRIMARY[@]} == 0)); then

        RISK_PRIMARY+=("$domain")
        return

    fi

    local current_priority
    local new_priority

    current_priority="$(
        domain_priority "${RISK_PRIMARY[0]}"
    )"

    new_priority="$(
        domain_priority "$domain"
    )"

    if (( new_priority > current_priority )); then

        if ! domain_exists \
            "${RISK_PRIMARY[0]}" \
            "${RISK_ADDITIONAL[@]}"; then

            RISK_ADDITIONAL+=("${RISK_PRIMARY[0]}")

        fi

        RISK_PRIMARY=("$domain")

        return

    fi

    if ! domain_exists \
        "$domain" \
        "${RISK_PRIMARY[@]}" \
        "${RISK_ADDITIONAL[@]}"; then

        RISK_ADDITIONAL+=("$domain")

    fi
}

promote_information_domain() {

    local domain="$1"

    if ((${#INFO_PRIMARY[@]} == 0)); then

        INFO_PRIMARY+=("$domain")
        return

    fi

    if ! domain_exists \
        "$domain" \
        "${INFO_PRIMARY[@]}" \
        "${INFO_ADDITIONAL[@]}"; then

        INFO_ADDITIONAL+=("$domain")

    fi
}

record_domain() {

    local domain="$1"

    if is_risk_domain "$domain"; then

        promote_risk_domain "$domain"
        return

    fi

    if is_information_domain "$domain"; then

        promote_information_domain "$domain"

    fi
}

###############################################################################
# Evaluation
###############################################################################

record_engineering_context() {

    local knowledge="$1"

    #
    # Engineering Domain
    #

    local domain

    domain="$(
        knowledge_category "$knowledge"
    )"

    record_domain "$domain"

    #
    # Engineering Context
    #

    mapfile -t NEW_CONTEXT < <(
        knowledge_findings "$knowledge"
    )

    local context

    for context in "${NEW_CONTEXT[@]}"; do
        ENGINEERING_CONTEXT+=("$context")
    done

    #
    # Recommendations
    #

    mapfile -t NEW_RECOMMENDATIONS < <(
        knowledge_recommendations "$knowledge"
    )

    local recommendation

    for recommendation in "${NEW_RECOMMENDATIONS[@]}"; do
        RECOMMENDATIONS+=("$recommendation")
    done
}

evaluate_knowledge() {

    local evidence="$1"
    local knowledge="$2"

    mapfile -t MATCHES < <(
        knowledge_matches "$knowledge"
    )

    local match

    for match in "${MATCHES[@]}"; do

        local type
        local value

        IFS=$'\t' read -r type value <<<"$match"

        if ! matches \
            "$evidence" \
            "$type" \
            "$value"; then

            continue

        fi

        record_engineering_context "$knowledge"

        return

    done
}

evaluate_evidence() {

    local evidence="$1"

    mapfile -t KNOWLEDGE_ITEMS < <(
        knowledge_items
    )

    local knowledge

    for knowledge in "${KNOWLEDGE_ITEMS[@]}"; do

        evaluate_knowledge \
            "$evidence" \
            "$knowledge"

    done
}

evaluate() {

    #
    # Engineering Domains
    #

    RISK_PRIMARY=()
    RISK_ADDITIONAL=()

    INFO_PRIMARY=()
    INFO_ADDITIONAL=()

    #
    # Engineering Context
    #

    ENGINEERING_CONTEXT=()

    RECOMMENDATIONS=()

    #
    # Knowledge
    #

    load_knowledge \
        "$WORKSTATION_ROOT/heuristics/review"

    #
    # Evidence
    #

    local evidence

    for evidence in "${EVIDENCE[@]}"; do

        evaluate_evidence "$evidence"

    done
}

###############################################################################
# Rendering
###############################################################################

render_summary() {

    section "Summary"

    local line

    for line in "${SUMMARY[@]}"; do
        printf "  • %s\n" "$line"
    done
}

render_evidence() {

    section "Evidence"

    if ((${#EVIDENCE[@]} == 0)); then
        printf "  Working tree is clean.\n"
        return
    fi

    local evidence

    for evidence in "${EVIDENCE[@]}"; do
        printf "  %s\n" "$evidence"
    done
}

render_diff() {

    [[ -z "$DIFF_STAT" ]] && return

    section "Diff Summary"

    printf "%s\n" "$DIFF_STAT"
}

render_engineering_context() {

    section "Engineering Context"

    if ((${#ENGINEERING_CONTEXT[@]} == 0)); then
        printf "  • No findings.\n"
        return
    fi

    #
    # Deduplicate findings while preserving order.
    #

    local UNIQUE=()

    local finding

    for finding in "${ENGINEERING_CONTEXT[@]}"; do

        local seen=false
        local existing

        for existing in "${UNIQUE[@]}"; do

            if [[ "$existing" == "$finding" ]]; then
                seen=true
                break
            fi

        done

        if ! $seen; then
            UNIQUE+=("$finding")
        fi

    done

    for finding in "${UNIQUE[@]}"; do
        printf "  • %s\n" "$finding"
    done
}

render_focus() {

    section "Engineering Focus"

    if ((${#RISK_PRIMARY[@]})); then

        printf "\nRisk-bearing\n\n"

        printf "Primary\n"

        local domain

        for domain in "${RISK_PRIMARY[@]}"; do
            printf "  • %s\n" "$domain"
        done

    fi

    if ((${#RISK_ADDITIONAL[@]})); then

        printf "\nAdditional\n"

        local domain

        for domain in "${RISK_ADDITIONAL[@]}"; do
            printf "  • %s\n" "$domain"
        done

    fi

    if ((${#INFO_PRIMARY[@]})); then

        printf "\nInformational\n\n"

        printf "Primary\n"

        local domain

        for domain in "${INFO_PRIMARY[@]}"; do
            printf "  • %s\n" "$domain"
        done

    fi

    if ((${#INFO_ADDITIONAL[@]})); then

        printf "\nAdditional\n"

        local domain

        for domain in "${INFO_ADDITIONAL[@]}"; do
            printf "  • %s\n" "$domain"
        done

    fi
}

render_recommendations() {

    section "Recommendations"

    if ((${#RECOMMENDATIONS[@]} == 0)); then
        printf "  • Continue current work.\n"
        return
    fi

    #
    # Deduplicate recommendations while preserving order.
    #

    local UNIQUE=()

    local recommendation

    for recommendation in "${RECOMMENDATIONS[@]}"; do

        local seen=false
        local existing

        for existing in "${UNIQUE[@]}"; do

            if [[ "$existing" == "$recommendation" ]]; then
                seen=true
                break
            fi

        done

        if ! $seen; then
            UNIQUE+=("$recommendation")
        fi

    done

    for recommendation in "${UNIQUE[@]}"; do
        printf "  • %s\n" "$recommendation"
    done
}

render_human() {

    heading "Engineering Confidence Review"

    render_summary

    render_evidence

    render_diff

    render_focus

    render_engineering_context

    render_recommendations

    printf "\n"
}

###############################################################################
# Main
###############################################################################

main() {

    collect

    evaluate

    render_human
}

main "$@"
