#!/usr/bin/env bash

set -euo pipefail

###############################################################################
# Bootstrap
###############################################################################

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKSTATION_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# shellcheck source-path=SCRIPTDIR/..
# shellcheck source=lib/workstation.sh
source "$WORKSTATION_ROOT/lib/workstation.sh"

eval "$(ctx --env)"

require_git

###############################################################################
# Review
###############################################################################

collect_repository_state() {

    DIRTY="No"

    if [[ -n "$(git status --porcelain)" ]]; then
        DIRTY="Yes"
    fi
}

collect_change_summary() {

    ADDED=0
    MODIFIED=0
    DELETED=0
    RENAMED=0

    while IFS= read -r line; do

        status="${line:0:2}"

        case "$status" in
            "A "|"??")
                ((ADDED++))
                ;;
            " M"|"M ")
                ((MODIFIED++))
                ;;
            " D"|"D ")
                ((DELETED++))
                ;;
            R*)
                ((RENAMED++))
                ;;
        esac

    done < <(git status --porcelain)

}

render_repository() {

    section "Repository"

    printf "  Branch    %s\n" "$CTX_BRANCH"
    printf "  Dirty     %s\n" "$DIRTY"
}

render_changes() {

    section "Changes"

    printf "  Added      %d\n" "$ADDED"
    printf "  Modified   %d\n" "$MODIFIED"
    printf "  Deleted    %d\n" "$DELETED"
    printf "  Renamed    %d\n" "$RENAMED"
}

render_files() {

    section "Files"

    git status --short
}

render_diff_summary() {

    local diff_stat

    diff_stat="$(git diff --stat)"

    if [[ -n "$diff_stat" ]]; then

        section "Diff Summary"

        printf "%s\n" "$diff_stat"

    fi
}

###############################################################################
# Main
###############################################################################

main() {

    heading "Engineering Situation Report"

    collect_repository_state
    collect_change_summary

    render_repository
    render_changes
    render_files
    render_diff_summary
}

main "$@"
